{
  "name": "uni-math-course",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "French–English mathematics learning pilot",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:docs": "node scripts/check-repository.mjs && node scripts/sync-release-status.mjs",
    "check:content": "node scripts/check-content.mjs",
    "typecheck": "astro check",
    "format": "prettier --write 'src/**/*.{astro,ts,tsx,css}' 'scripts/*.mjs' 'tests/**/*.{mjs,ts}' '*.{json,mjs,ts}' '.github/workflows/check.yml'",
    "format:check": "prettier --check 'src/**/*.{astro,ts,tsx,css}' 'scripts/*.mjs' 'tests/**/*.{mjs,ts}' '*.{json,mjs,ts}' '.github/workflows/check.yml'",
    "test": "node --test tests/claude/*.test.mjs tests/content/*.test.mjs tests/repository/*.test.mjs tests/auth/*.test.ts tests/attempts/*.test.ts",
    "check": "pnpm check:docs && pnpm check:release && pnpm check:content && pnpm typecheck && pnpm format:check && pnpm test && pnpm build",
    "test:e2e": "playwright test",
    "build:test": "ASTRO_TEST_BUILD=1 astro build",
    "sync:release-status": "node scripts/sync-release-status.mjs --write",
    "check:release": "node scripts/check-release.mjs",
    "test:e2e:hosted": "playwright test --config playwright.hosted.config.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/react": "7.0.1",
    "@astrojs/vercel": "11.0.14",
    "@radix-ui/themes": "3.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "astro": "7.3.8",
    "katex": "0.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/node": "11.1.7",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3"
  }
}
