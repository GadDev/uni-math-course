{
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.env.*.local)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(.claude/hooks/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": [
        ".env",
        ".env.local",
        ".env.development",
        ".env.production",
        ".env.test",
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.config/gh",
        "~/.npmrc",
        "~/.netrc",
        "~/Library/Keychains"
      ],
      "denyWrite": [
        ".claude/settings.json",
        ".claude/settings.local.json",
        ".claude/hooks"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "cdn.playwright.dev"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/confine-paths.mjs\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking paths stay inside the project"
          }
        ]
      }
    ]
  }
}
