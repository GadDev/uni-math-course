{
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.env.*.local)",
      "Read(~/Downloads/**)",
      "Read(~/Desktop/**)",
      "Read(~/Library/Mobile Documents/**)",
      "Read(~/Library/CloudStorage/**)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.test)",
      "Edit(**/.env.*.local)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(.claude/hooks/**)",
      "Edit(.github/workflows/**)",
      "Edit(.vscode/**)",
      "Edit(tests/claude/**)",
      "mcp__ide__executeCode"
    ],
    "ask": ["WebFetch", "Artifact"]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "filesystem": {
      "denyRead": [
        "**/.env",
        "**/.env.local",
        "**/.env.development",
        "**/.env.production",
        "**/.env.test",
        "**/.env.staging",
        "**/.env.*.local",
        "~/Downloads",
        "~/Desktop",
        "~/Library/Mobile Documents",
        "~/Library/CloudStorage",
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.config/gh",
        "~/.npmrc",
        "~/.netrc",
        "~/Library/Keychains"
      ],
      "denyWrite": [
        ".claude/settings.json",
        ".claude/settings.local.json",
        ".claude/hooks",
        ".mcp.json",
        "**/.env",
        "**/.env.local",
        "**/.env.development",
        "**/.env.production",
        "**/.env.test",
        "**/.env.*.local"
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "cdn.playwright.dev"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/confine-paths.ts\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking paths stay inside the project"
          }
        ]
      }
    ]
  }
}
