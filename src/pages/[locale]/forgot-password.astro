---
import Base from '../../layouts/Base.astro';
import { authCopy } from '../../lib/auth/copy';
import { localeOf } from '../../lib/auth/policy';

export const prerender = false;
if (!['fr', 'en'].includes(Astro.params.locale ?? ''))
  return new Response('Not found', { status: 404 });
const locale = localeOf(Astro.params.locale);
const text = authCopy[locale];
const auth = Astro.locals.auth;
const sent = Astro.url.searchParams.get('sent') === '1';
---

<Base
  locale={locale}
  title={text.forgotTitle}
  description={text.forgotIntro}
  path="forgot-password/"
>
  <main id="main" class="auth-page">
    <p class="eyebrow">{text.forgotPassword}</p>
    <h1>{text.forgotTitle}</h1>
    <p class="lede">{text.forgotIntro}</p>
    {sent && (
      <p class="auth-message" role="status">
        {text.forgotSent}
      </p>
    )}
    <section class="auth-card" aria-label={text.forgotTitle}>
      <form method="post" action="/auth/forgot-password/" class="auth-form">
        <input type="hidden" name="locale" value={locale} />
        <label for="email">{text.email}</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          maxlength="254"
          required
          disabled={!auth}
        />
        <button class="primary-link auth-button" type="submit" disabled={!auth}>
          {text.forgotSubmit}
        </button>
      </form>
      {!auth && <p role="status">{text.disabled}</p>}
    </section>
    <a class="back-link" href={`/${locale}/sign-in/`}>
      {text.backToSignIn}
    </a>
  </main>
</Base>
