---
import { workshopCopy } from '../../lib/logic-workshop/copy';
import CourseOverview from '../../components/CourseOverview.astro';
import ProgrammeDashboard from '../../components/ProgrammeDashboard.astro';
import { completionCopy } from '../../lib/completion-copy';
import TrainingExamLink from '../../components/TrainingExamLink.astro';
import Base from '../../layouts/Base.astro';
import ReadingNotice from '../../components/ReadingNotice.astro';
import RevisionDownloads from '../../components/RevisionDownloads.astro';
import { copy, locales } from '../../lib/i18n';
import { authCopy } from '../../lib/auth/copy';
import { glossaryCopy } from '../../lib/glossary';
import SignalGeometry from '../../components/SignalGeometry.astro';
import katex from 'katex';
import { getCollection } from 'astro:content';
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props;
const text = copy[locale];
const programmeParts = [
  {
    title:
      locale === 'fr'
        ? '1. Logique propositionnelle classique'
        : '1. Classical propositional logic',
    pages: '3–35',
    lessons: text.programme.slice(0, 8),
  },
  {
    title:
      locale === 'fr'
        ? '2. Théorie naïve des ensembles'
        : '2. Naive set theory',
    pages: '37–65',
    lessons: text.programme.slice(8, 15),
  },
  {
    title:
      locale === 'fr'
        ? '3. Applications IT : du français au langage symbolique'
        : '3. IT applications: from everyday language to symbols',
    pages: '67–96',
    lessons: text.programme.slice(15),
  },
];
const releasedIds = new Set(
  (await getCollection('lessons'))
    .filter((entry) => entry.data.locale === locale)
    .map((entry) => entry.data.lessonId),
);
const implication = katex.renderToString('A \\Rightarrow B', {
  output: 'htmlAndMathml',
  throwOnError: true,
});
---

<Base
  locale={locale}
  title={
    locale === 'fr' ? 'Mathématiques · Semestre 3' : 'Mathematics · Semester 3'
  }
  description={
    locale === 'fr'
      ? 'Quatre chapitres : logique, droites, fonctions et théorie de l’information. Leçons, ateliers et révisions.'
      : 'Four chapters: logic, straight lines, functions and information theory. Lessons, workshops and revision.'
  }
>
  <main id="main" tabindex="-1" class="course-page">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">
          {locale === 'fr'
            ? 'COURS UNIVERSITAIRE · FR / EN'
            : 'UNIVERSITY COURSE · FR / EN'}
        </p>
        <h1 class="signal-title course-title">
          <span>{locale === 'fr' ? 'Mathématiques' : 'Mathematics'}</span>
          <span>
            {locale === 'fr' ? 'Semestre 3' : 'Semester 3'}
            <span class="signal-stop">.</span>
          </span>
        </h1>
        <p class="hero-motto">{text.motto}</p>
        <p class="lede">
          {locale === 'fr'
            ? 'Quatre chapitres pour comprendre, s’entraîner et préparer l’examen, à votre rythme.'
            : 'Four chapters to understand, practise and prepare for your exam at your own pace.'}
        </p>
        <a class="primary-link" href={`/${locale}/lessons/L01/`}>
          {locale === 'fr' ? 'Commencer avec la logique' : 'Start with logic'} →
        </a>
        <p class="status">
          <span aria-hidden="true">●</span> {text.pilot}
        </p>
      </div>
      <div class="hero-art">
        <SignalGeometry />
      </div>
    </section>
    <CourseOverview locale={locale} />
    <section
      id="chapter-01"
      class="planned-section programme-section"
      aria-labelledby="planned-title"
    >
      <ProgrammeDashboard
        locale={locale}
        chapterId="C01"
        objectives={
          locale === 'fr'
            ? [
                'Construire des tables de vérité et raisonner avec les connecteurs logiques.',
                'Manipuler les ensembles et utiliser les quantificateurs pour formaliser des énoncés.',
              ]
            : [
                'Build truth tables and reason with logical connectives.',
                'Work with sets and use quantifiers to formalise statements.',
              ]
        }

        chapterTitle={
          locale === 'fr' ? 'Logique et ensembles' : 'Logic and sets'
        }
        headingId="planned-title"
        title={
          locale === 'fr'
            ? 'Le parcours de logique et ensembles'
            : 'The logic and sets pathway'
        }
        intro={
          locale === 'fr'
            ? 'Trois étapes pour passer des idées aux symboles. Des explications pas à pas, des exemples et des exercices pour avancer à votre rythme.'
            : 'Three stages from ideas to symbols. Step-by-step explanations, examples and exercises to work through at your own pace.'
        }
        lessons={text.programme.filter((topic) => releasedIds.has(topic.id))}
        action={{
          title: workshopCopy.title[locale],
          description:
            locale === 'fr'
              ? 'Manipulez les formules, construisez vos tables de vérité et testez votre raisonnement.'
              : 'Explore formulas, build truth tables and test your reasoning.',
          href: `/${locale}/logic-workshop/`,
          label: locale === 'fr' ? 'Ouvrir l’atelier' : 'Open the workshop',
        }}
        jumps={programmeParts.map((part, index) => ({
          href: `#programme-part-${index + 1}`,
          label:
            locale === 'fr'
              ? ([
                  'Logique propositionnelle',
                  'Théorie des ensembles',
                  'Applications IT',
                ][index] ?? part.title)
              : (['Propositional logic', 'Set theory', 'IT applications'][
                  index
                ] ?? part.title),
        }))}
      >
        {programmeParts.map((part, index) => (
          <section
            class="programme-part"
            id={`programme-part-${index + 1}`}
            aria-label={part.title}
          >
            <h3>{part.title}</h3>
            <p class="programme-source">
              {part.lessons.length} {locale === 'fr' ? 'leçons' : 'lessons'} ·{' '}
              {locale === 'fr' ? 'Pages PDF' : 'PDF pages'} {part.pages}
            </p>
            <ul class="planned-list">
              {part.lessons.map((topic) => (
                <li
                  class={
                    releasedIds.has(topic.id) ? 'available-topic' : undefined
                  }
                >
                  <span class="planned-number" aria-hidden="true">
                    {topic.id.slice(1)}
                  </span>
                  {releasedIds.has(topic.id) ? (
                    <a href={'/' + locale + '/lessons/' + topic.id + '/'}>
                      {topic.title}
                      <span
                        class="completion-badge"
                        data-completion-badge={topic.id}
                        hidden
                      >
                        ✓ {completionCopy[locale].completed}
                      </span>
                    </a>
                  ) : (
                    <span>{topic.title}</span>
                  )}
                  <span class="planned-label">
                    {releasedIds.has(topic.id) ? text.public : text.planned}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </ProgrammeDashboard>
    </section>
    <RevisionDownloads locale={locale} />
    <section class="lesson-feature" aria-labelledby="pilot-title">
      <div class="lesson-index" aria-hidden="true">
        05
      </div>
      <div class="featured-identity">
        <p class="eyebrow">{text.lesson}</p>
        <h2 id="pilot-title">{text.lessonTitle}</h2>
        <div class="feature-formula" set:html={implication} />
        <p class="formula-reading">{text.formulaReading}</p>
      </div>
      <div class="featured-description">
        <p>{text.description}</p>
        <div class="lesson-meta">
          <span>{text.public}</span>
          <span>{text.time}</span>
        </div>
      </div>
      <div class="featured-action">
        <a class="primary-link" href={'/' + locale + '/lessons/L05/'}>
          {text.read}
          <span aria-hidden="true"> →</span>
        </a>
      </div>
    </section>
    <section class="planned-section" aria-labelledby="glossary-title">
      <h2 id="glossary-title">{glossaryCopy[locale].title}</h2>
      <p>{glossaryCopy[locale].intro}</p>
      <a class="primary-link" href={'/' + locale + '/glossary/'}>
        {glossaryCopy[locale].nav} →
      </a>
    </section>
    <section class="planned-section" aria-labelledby="numbers-title">
      <p class="eyebrow">{locale === 'fr' ? 'FONDATIONS' : 'FOUNDATIONS'}</p>
      <h2 id="numbers-title">
        {locale === 'fr' ? 'La famille des nombres' : 'The number family'}
      </h2>
      <p>
        {locale === 'fr'
          ? 'Explorez les naturels, les entiers, les rationnels, les réels et les complexes à travers un schéma et des exemples.'
          : 'Explore natural, integer, rational, real and complex numbers through a visual family tree and worked examples.'}
      </p>
      <a class="primary-link" href={'/' + locale + '/numbers/'}>
        {locale === 'fr'
          ? 'Explorer les familles de nombres'
          : 'Explore the number families'}{' '}
        →
      </a>
    </section>
    <section class="planned-section" aria-labelledby="offline-title">
      <p class="eyebrow">
        PWA · {locale === 'fr' ? 'SANS CONNEXION' : 'OFFLINE'}
      </p>
      <h2 id="offline-title">
        {locale === 'fr'
          ? 'Emporter les leçons partout'
          : 'Take lessons anywhere'}
      </h2>
      <p>
        {locale === 'fr'
          ? 'Installez ce site comme une application et téléchargez les leçons publiques disponibles dans le pack pour les lire sans Internet.'
          : 'Install this site as an app and download the public lessons available in the pack to read without Internet.'}
      </p>
      <a class="primary-link" href={'/' + locale + '/offline/'}>
        {locale === 'fr'
          ? 'Préparer le mode hors ligne'
          : 'Prepare offline mode'}{' '}
        →
      </a>
    </section>
    <section class="practice-status" aria-labelledby="practice-title">
      <div class="practice-copy">
        <h2 id="practice-title">{text.practiceTitle}</h2>
        <p>{text.practice}</p>
        <p>
          <a href={`/${locale}/sign-in/`}>{authCopy[locale].signIn}</a>
        </p>
      </div>
      <ReadingNotice locale={locale} />
    </section>
    <TrainingExamLink locale={locale} chapterId="C01" />
  </main>
</Base>
