---
import Base from '../../layouts/Base.astro';
import ReadingNotice from '../../components/ReadingNotice';
import { copy, locales } from '../../lib/i18n';
import { authCopy } from '../../lib/auth/copy';
import { glossaryCopy } from '../../lib/glossary';
import SignalGeometry from '../../components/SignalGeometry.astro';
import katex from 'katex';
import { getCollection } from 'astro:content';
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props;
const text = copy[locale];
const releasedIds = new Set(
  (await getCollection('lessons'))
    .filter((entry) => entry.data.locale === locale)
    .map((entry) => entry.data.lessonId),
);
const implication = katex.renderToString('A \\Rightarrow B', {
  output: 'htmlAndMathml',
  throwOnError: true,
});
---

<Base locale={locale} title={text.course} description={text.intro}>
  <main id="main" tabindex="-1" class="course-page">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">{text.label}</p>
        <h1 class="signal-title">
          <span>
            {text.heroLines[0]}
            <span class="hero-ampersand"> &amp;</span>
          </span>
          <span>
            {text.heroLines[1]}
            <span class="signal-stop">.</span>
          </span>
        </h1>
        <p class="hero-motto">{text.motto}</p>
        <p class="lede">{text.intro}</p>
        <p class="status">
          <span aria-hidden="true">●</span> {text.pilot}
        </p>
      </div>
      <div class="hero-art">
        <SignalGeometry />
      </div>
    </section>
    <section class="lesson-feature" aria-labelledby="pilot-title">
      <div class="lesson-index" aria-hidden="true">
        05
      </div>
      <div class="featured-identity">
        <p class="eyebrow">{text.lesson}</p>
        <h2 id="pilot-title">{text.lessonTitle}</h2>
        <div class="feature-formula" set:html={implication} />
        <p class="formula-reading">{text.formulaReading}</p>
      </div>
      <div class="featured-description">
        <p>{text.description}</p>
        <div class="lesson-meta">
          <span>{text.public}</span>
          <span>{text.time}</span>
        </div>
      </div>
      <div class="featured-action">
        <a class="primary-link" href={'/' + locale + '/lessons/L05/'}>
          {text.read}
          <span aria-hidden="true"> →</span>
        </a>
      </div>
    </section>
    <section class="planned-section" aria-labelledby="planned-title">
      <h2 id="planned-title">{text.future}</h2>
      <ul class="planned-list">
        {text.programme.map((topic) => (
          <li class={releasedIds.has(topic.id) ? 'available-topic' : undefined}>
            <span class="planned-number" aria-hidden="true">
              {topic.id.slice(1)}
            </span>
            {releasedIds.has(topic.id) ? (
              <a href={'/' + locale + '/lessons/' + topic.id + '/'}>
                {topic.title}
              </a>
            ) : (
              <span>{topic.title}</span>
            )}
            <span class="planned-label">
              {releasedIds.has(topic.id) ? text.public : text.planned}
            </span>
          </li>
        ))}
      </ul>
    </section>
    <section class="planned-section" aria-labelledby="glossary-title">
      <h2 id="glossary-title">{glossaryCopy[locale].title}</h2>
      <p>{glossaryCopy[locale].intro}</p>
      <a class="primary-link" href={'/' + locale + '/glossary/'}>
        {glossaryCopy[locale].nav} →
      </a>
    </section>
    <section class="planned-section" aria-labelledby="numbers-title">
      <p class="eyebrow">{locale === 'fr' ? 'FONDATIONS' : 'FOUNDATIONS'}</p>
      <h2 id="numbers-title">{locale === 'fr' ? 'La famille des nombres' : 'The number family'}</h2>
      <p>
        {locale === 'fr'
          ? 'Explorez les naturels, les entiers, les rationnels, les réels et les complexes à travers un schéma et des exemples.'
          : 'Explore natural, integer, rational, real and complex numbers through a visual family tree and worked examples.'}
      </p>
      <a class="primary-link" href={'/' + locale + '/numbers/'}>
        {locale === 'fr' ? 'Explorer les familles de nombres' : 'Explore the number families'} →
      </a>
    </section>
    <section class="practice-status" aria-labelledby="practice-title">
      <div class="practice-copy">
        <h2 id="practice-title">{text.practiceTitle}</h2>
        <p>{text.practice}</p>
        <p>
          <a href={`/${locale}/sign-in/`}>{authCopy[locale].signIn}</a>
        </p>
      </div>
      <ReadingNotice locale={locale} client:load />
    </section>
  </main>
</Base>
