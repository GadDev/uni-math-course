---
import Base from '../../../layouts/Base.astro';
import { locales } from '../../../lib/i18n';
import { examChapters, examCopy } from '../../../lib/training-exams/copy';
import '../../../styles/training-exams.css';
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props;
const text = examCopy[locale];
---

<Base
  locale={locale}
  title={text.title}
  description={text.intro}
  path="training-exams/"
>
  <main id="main" tabindex="-1" class="exam-page">
    <p class="eyebrow">{text.eyebrow}</p>
    <h1>
      {text.title}
      <span class="signal-stop">.</span>
    </h1>
    <p class="lede">{text.intro}</p>
    <p>{text.independent}</p>
    <section
      class="exam-card final-exam-card"
      aria-labelledby="final-exam-entry"
    >
      <p class="eyebrow">
        {locale === 'fr'
          ? 'QUATRE CHAPITRES · COUVERTURE PARTIELLE · EN FRANÇAIS'
          : 'FOUR CHAPTERS · PARTIAL COVERAGE · IN FRENCH'}
      </p>
      <h2 id="final-exam-entry">
        {locale === 'fr'
          ? 'Examen blanc final — couverture partielle'
          : 'Final mock exam — partial coverage (in French)'}
      </h2>
      <p>
        {locale === 'fr'
          ? '120 minutes · 18 questions · banque de 180 questions. Logique, nombres, droites, fonctions, complexité et information (L43–L49).'
          : '120 minutes · 18 questions · bank of 180 questions. Logic, numbers, lines, functions, complexity and information (L43–L49).'}
      </p>
      <p>
        {locale === 'fr'
          ? 'Un nouveau sujet équilibré à chaque tentative, avec correction automatique et grilles d’autoévaluation après remise.'
          : 'A new balanced paper each attempt, with automatic marking and self-assessment rubrics after submission.'}
      </p>
      <p>
        {locale === 'fr'
          ? 'La banque actuelle couvre les bases de l’information, Huffman et l’entropie. Exclus : L50–L57 (arbres, Kraft–McMillan, Gibbs, preuve de la borne, blocs et LZW). Pas encore de sujet dédié au chapitre 4 ; utilisez les leçons et l’atelier LZW.'
          : 'The current bank covers information basics, Huffman and entropy. Excluded: L50–L57 (trees, Kraft–McMillan, Gibbs, bound proof, blocks and LZW). No dedicated Chapter 4 paper yet; use the lessons and LZW workshop.'}
      </p>
      <a class="primary-link" href="/fr/training-exams/final/">
        {locale === 'fr'
          ? 'Préparer l’examen final'
          : 'Prepare the final exam (in French)'}{' '}
        →
      </a>
    </section>
    <p>
      <a href={`/${locale}/cheat-sheet/#information`}>
        {locale === 'fr'
          ? 'Réviser le chapitre 4 et accéder aux leçons / atelier LZW'
          : 'Review Chapter 4 and find lessons / LZW workshop'}{' '}
        →
      </a>
    </p>
    <div class="exam-catalogue">
      {examChapters.map((chapter) => (
        <section
          id={chapter.id}
          class="exam-card"
          aria-labelledby={`exam-${chapter.id}`}
        >
          <p class="eyebrow">
            {locale === 'fr' ? 'CHAPITRE' : 'CHAPTER'} {chapter.id.slice(1)} ·{' '}
            {chapter.lessons}
          </p>
          <h2 id={`exam-${chapter.id}`}>{chapter.title[locale]}</h2>
          <p>{chapter.topics[locale]}</p>
          <p>
            <strong>{text.format}</strong>
          </p>
          <p>{text.types}</p>
          <a
            class="primary-link"
            href={`/${locale}/training-exams/${chapter.id}/`}
          >
            {text.launch} →
          </a>
        </section>
      ))}
    </div>
    <section class="exam-preparation" aria-labelledby="exam-how">
      <h2 id="exam-how">{text.preparation}</h2>
      <p>{text.rules}</p>
      <p>{text.marking}</p>
      <p>{text.privacy}</p>
      <p class="status">{text.review}</p>
    </section>
  </main>
</Base>
