---
import { getCollection, render } from 'astro:content';
import LessonCompletion from '../../../components/LessonCompletion.astro';
import { completionCopy } from '../../../lib/completion-copy';
import Base from '../../../layouts/Base.astro';
import ReadingNotice from '../../../components/ReadingNotice.astro';
import { copy } from '../../../lib/i18n';
import { RELEASED_LESSONS } from '../../../lib/released-lessons';
import { glossaryCopy } from '../../../lib/glossary';
import SignalGeometry from '../../../components/SignalGeometry.astro';
import DroitesSourcePath from '../../../components/DroitesSourcePath.astro';
import '../../../styles/droites-teaching.css';
import { chapterForPath, chapterHref } from '../../../lib/chapters';
export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((lesson) => ({
    params: { locale: lesson.data.locale, lessonId: lesson.data.lessonId },
    props: { lesson },
  }));
}
const { lesson } = Astro.props;
const { Content, headings } = await render(lesson);
const locale = lesson.data.locale;
const text = copy[locale];
const alternate = locale === 'fr' ? 'en' : 'fr';
const counterpart = (await getCollection('lessons')).find(
  (entry) =>
    entry.data.lessonId === lesson.data.lessonId &&
    entry.data.locale === alternate,
);
if (!counterpart) throw new Error('Missing paired lesson translation');
const { headings: pairedHeadings } = await render(counterpart);
if (headings.length !== pairedHeadings.length)
  throw new Error('Unaligned bilingual lesson sections');
const alternateAnchors = Object.fromEntries(
  headings.map((heading, index) => {
    const paired = pairedHeadings[index];
    if (!paired || heading.depth !== paired.depth)
      throw new Error('Unaligned bilingual lesson sections');
    return [heading.slug, paired.slug];
  }),
);
const sections = headings.filter((heading) => heading.depth === 2);
const releasedIds = new Set(
  (await getCollection('lessons'))
    .filter((entry) => entry.data.locale === locale)
    .map((entry) => entry.data.lessonId),
);
const lessonNumber = lesson.data.lessonId.slice(1);
const chapter = chapterForPath(`lessons/${lesson.data.lessonId}/`);
if (!chapter) throw new Error('Lesson has no chapter');
const chapterLink = chapterHref(locale, chapter);
const outline = (await getCollection('lessons'))
  .filter(
    (entry) =>
      entry.data.locale === locale &&
      chapter.lessonIds.some((id) => id === entry.data.lessonId),
  )
  .sort((a, b) => a.data.lessonId.localeCompare(b.data.lessonId))
  .map((entry) => ({ id: entry.data.lessonId, title: entry.data.title }));
// Lessons whose exercise bank is served by the API (no answers in this module).
const practiceLessons = RELEASED_LESSONS;
// One representative glossary entry per lesson, linked at the end of the page.
const glossaryLinks: Record<string, [string, string]> = {
  L01: ['E02', '0, 1'],
  L02: ['E08', '∧'],
  L03: ['E01', 'A, B, C'],
  L04: ['E16', '≡'],
  L05: ['E13', '⇒'],
  L06: ['E14', 'B ⇒ A'],
  L07: ['E15', '⇔'],
  L08: ['E09', '∨'],
  L09: ['E29', '{…}'],
  L10: ['E32', '⊆'],
  L11: ['E45', 'P(x)'],
  L12: ['E50', '¬∀, ¬∃'],
  L13: ['E33', '{a ∈ X | P(a)}'],
  L14: ['E35', '𝒫(A)'],
  L15: ['E36', '∩'],
  L16: ['E48', '∀x ∈ X'],
  L17: ['E40', '×'],
  L18: ['E53', 'EXISTS'],
  L19: ['E55', 'all, any'],
  L20: ['E45', 'S(u, f)'],
};
const glossaryLink = glossaryLinks[lesson.data.lessonId];
const geometryVariant =
  chapter.id === 'C03'
    ? 'functions-mosaic'
    : chapter.id === 'C02'
      ? 'decalage'
      : 'logic';
---

<Base
  locale={locale}
  title={lesson.data.title}
  description={lesson.data.summary}
  path={'lessons/' + lesson.data.lessonId + '/'}
  alternateAnchors={alternateAnchors}
>
  <main id="main" tabindex="-1" class="lesson-page" data-chapter={chapter.id}>
    <aside class="course-outline">
      <p class="eyebrow">{text.outline}</p>
      <ol class="outline-topics">
        {outline.map((topic) => (
          <li
            class={
              topic.id === lesson.data.lessonId ? 'current-topic' : undefined
            }
            aria-current={
              topic.id === lesson.data.lessonId ? 'page' : undefined
            }
          >
            <span class="outline-number">{topic.id.slice(1)}</span>
            <span>
              {releasedIds.has(topic.id) &&
              topic.id !== lesson.data.lessonId ? (
                <a href={'/' + locale + '/lessons/' + topic.id + '/'}>
                  {topic.title}
                </a>
              ) : (
                topic.title
              )}
              <span
                class="completion-badge"
                data-completion-badge={topic.id}
                hidden
              >
                ✓ {completionCopy[locale].completed}
              </span>
              {!releasedIds.has(topic.id) && <small>{text.planned}</small>}
            </span>
          </li>
        ))}
      </ol>
      <nav class="section-nav" aria-label={text.contents}>
        <h2>{text.contents}</h2>
        <ol>
          {sections.map((section) => (
            <li>
              <a href={'#' + section.slug}>{section.text}</a>
            </li>
          ))}
        </ol>
      </nav>
      {chapter.id === 'C02' && (
        <DroitesSourcePath locale={locale} lessonId={lesson.data.lessonId} />
      )}
    </aside>
    <div class="reading-column">
      <nav
        class="breadcrumb"
        aria-label={locale === 'fr' ? 'Fil d’Ariane' : 'Breadcrumb'}
      >
        <a href={chapterLink}>{chapter.title[locale]}</a>
        <span aria-hidden="true"> / </span>
        <span>{lesson.data.lessonId}</span>
      </nav>
      <p class="eyebrow">
        <span class="lesson-tag">{lessonNumber}</span> / {text.understand} ·{' '}
        {lesson.data.minutes} min
      </p>
      <details class="mobile-contents">
        <summary>{text.contents}</summary>
        <nav aria-label={text.contents}>
          <ol>
            {sections.map((section) => (
              <li>
                <a href={'#' + section.slug}>{section.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
      <div class="reading-geometry">
        <SignalGeometry compact variant={geometryVariant} />
      </div>
      <article class="lesson-prose" data-lesson-id={lesson.data.lessonId}>
        <Content />
      </article>
      {lesson.data.lessonId === 'L10' && (
        <p>
          <a href={'/' + locale + '/numbers/'}>
            {locale === 'fr'
              ? 'Guide visuel : familles de nombres'
              : 'Visual guide: number families'}
          </a>
        </p>
      )}
      {practiceLessons.includes(lesson.data.lessonId) && (
        <p>
          <a
            class="primary-link"
            href={
              '/' + locale + '/lessons/' + lesson.data.lessonId + '/practice/'
            }
          >
            {locale === 'fr' ? 'S’exercer' : 'Practise'} →
          </a>
        </p>
      )}
      {glossaryLink && (
        <p>
          <a href={'/' + locale + '/glossary/#' + glossaryLink[0]}>
            {glossaryCopy[locale].nav} : {glossaryLink[1]}
          </a>
        </p>
      )}
      <p class="content-provenance">
        {lesson.data.status === 'pilot' ? text.review : text.reviewExtended}
      </p>
      <LessonCompletion
        locale={locale}
        lessonId={lesson.data.lessonId}
        lessonIds={outline.map((topic) => topic.id)}
        nextLesson={
          outline[
            outline.findIndex((topic) => topic.id === lesson.data.lessonId) + 1
          ]
        }
      />
      <ReadingNotice locale={locale} />
      <a class="back-link" href={chapterLink}>
        ← {text.next}
      </a>
    </div>
  </main>
</Base>
