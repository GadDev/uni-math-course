---
import { workshopCopy } from '../../../lib/logic-workshop/copy';
import { getCollection, render } from 'astro:content';
import LessonCompletion from '../../../components/LessonCompletion.astro';
import { completionCopy } from '../../../lib/completion-copy';
import Base from '../../../layouts/Base.astro';
import ReadingNotice from '../../../components/ReadingNotice.astro';
import { copy } from '../../../lib/i18n';
import { RELEASED_LESSONS } from '../../../lib/released-lessons';
import { glossaryCopy } from '../../../lib/glossary';
import SignalGeometry from '../../../components/SignalGeometry.astro';
import DroitesSourcePath from '../../../components/DroitesSourcePath.astro';
import ImplicationExplorers from '../../../components/ImplicationExplorers.astro';
import '../../../styles/droites-teaching.css';
import { chapterForPath, chapterHref } from '../../../lib/chapters';
export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((lesson) => ({
    params: { locale: lesson.data.locale, lessonId: lesson.data.lessonId },
    props: { lesson },
  }));
}
const { lesson } = Astro.props;
const { Content, headings } = await render(lesson);
const locale = lesson.data.locale;
const fr = locale === 'fr';
const changeLesson = fr ? 'Changer de leçon' : 'Change lesson';
const localizedLessons = (await getCollection('lessons')).filter(
  (entry) => entry.data.locale === locale,
);
const prerequisites = lesson.data.prerequisites.flatMap((id) => {
  const entry = localizedLessons.find((entry) => entry.data.lessonId === id);
  return entry ? [{ id, title: entry.data.title }] : [];
});
const text = copy[locale];
const alternate = locale === 'fr' ? 'en' : 'fr';
const counterpart = (await getCollection('lessons')).find(
  (entry) =>
    entry.data.lessonId === lesson.data.lessonId &&
    entry.data.locale === alternate,
);
if (!counterpart) throw new Error('Missing paired lesson translation');
const { headings: pairedHeadings } = await render(counterpart);
if (headings.length !== pairedHeadings.length)
  throw new Error('Unaligned bilingual lesson sections');
const alternateAnchors = Object.fromEntries(
  headings.map((heading, index) => {
    const paired = pairedHeadings[index];
    if (!paired || heading.depth !== paired.depth)
      throw new Error('Unaligned bilingual lesson sections');
    return [heading.slug, paired.slug];
  }),
);
const sections = headings.filter((heading) => heading.depth === 2);
const lessonNumber = lesson.data.lessonId.slice(1);
const chapter = chapterForPath(`lessons/${lesson.data.lessonId}/`);
if (!chapter) throw new Error('Lesson has no chapter');
const chapterLink =
  chapterHref(locale, chapter) + (chapter.id === 'C01' ? '#chapter-01' : '');
const outline = localizedLessons
  .filter((entry) => chapter.lessonIds.some((id) => id === entry.data.lessonId))
  .sort((a, b) => a.data.lessonId.localeCompare(b.data.lessonId))
  .map((entry) => ({ id: entry.data.lessonId, title: entry.data.title }));
const nextLesson =
  outline[outline.findIndex((topic) => topic.id === lesson.data.lessonId) + 1];
// Lessons whose exercise bank is served by the API (no answers in this module).
const practiceLessons = RELEASED_LESSONS;
// One representative glossary entry per lesson, linked at the end of the page.
const glossaryLinks: Record<string, [string, string]> = {
  L01: ['E02', '0, 1'],
  L02: ['E08', '∧'],
  L03: ['E01', 'A, B, C'],
  L04: ['E16', '≡'],
  L05: ['E13', '⇒'],
  L06: ['E14', 'B ⇒ A'],
  L07: ['E15', '⇔'],
  L08: ['E09', '∨'],
  L09: ['E29', '{…}'],
  L10: ['E32', '⊆'],
  L11: ['E45', 'P(x)'],
  L12: ['E50', '¬∀, ¬∃'],
  L13: ['E33', '{a ∈ X | P(a)}'],
  L14: ['E35', '𝒫(A)'],
  L15: ['E36', '∩'],
  L16: ['E48', '∀x ∈ X'],
  L17: ['E40', '×'],
  L18: ['E53', 'EXISTS'],
  L19: ['E55', 'all, any'],
  L20: ['E45', 'S(u, f)'],
  L43: ['E65', 'c'],
  L44: ['E65', 'c'],
  L45: ['E66', 'c(u) = c(v)'],
  L46: ['E67', 'pᵢ'],
  L47: ['E67', 'L(c)'],
  L48: ['E69', 'H(S)'],
  L49: ['E67', 'L(c)'],
  L50: ['E67', 'L(c)'],
  L51: ['E70', 'K'],
  L52: ['E71', 'qᵢ'],
  L53: ['E71', 'H(S) ≤ L(c)'],
  L54: ['E72', 'Sⁿ'],
};
const glossaryLink = glossaryLinks[lesson.data.lessonId];
const geometryVariant =
  chapter.id === 'C04'
    ? 'ember'
    : chapter.id === 'C03'
      ? 'functions-mosaic'
      : chapter.id === 'C02'
        ? 'decalage'
        : 'logic';
---

<Base
  locale={locale}
  title={lesson.data.title}
  description={lesson.data.summary}
  path={'lessons/' + lesson.data.lessonId + '/'}
  alternateAnchors={alternateAnchors}
>
  <main id="main" tabindex="-1" class="lesson-page" data-chapter={chapter.id}>
    <aside class="course-outline">
      <nav class="section-nav" aria-label={text.contents}>
        <h2>{text.contents}</h2>
        <ol>
          {sections.map((section) => (
            <li>
              <a href={'#' + section.slug}>{section.text}</a>
            </li>
          ))}
        </ol>
      </nav>
      {chapter.id === 'C02' && (
        <DroitesSourcePath locale={locale} lessonId={lesson.data.lessonId} />
      )}
    </aside>
    <div class="reading-column">
      <nav
        class="breadcrumb"
        aria-label={locale === 'fr' ? 'Fil d’Ariane' : 'Breadcrumb'}
      >
        <a href={chapterLink}>{chapter.title[locale]}</a>
        <span aria-hidden="true"> / </span>
        <span>{lesson.data.lessonId}</span>
      </nav>
      <p class="eyebrow">
        <span class="lesson-tag">{lessonNumber}</span> / {text.understand} ·{' '}
        {lesson.data.minutes} min
      </p>
      <details class="mobile-contents">
        <summary>{text.contents}</summary>
        <nav aria-label={text.contents}>
          <ol>
            {sections.map((section) => (
              <li>
                <a href={'#' + section.slug}>{section.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
      <details class="lesson-switcher">
        <summary>{changeLesson}</summary>
        <nav aria-label={changeLesson}>
          <ol class="outline-topics">
            {outline.map((topic) => (
              <li
                class:list={{
                  'current-topic': topic.id === lesson.data.lessonId,
                }}
              >
                <span class="outline-number">{topic.id}</span>
                <span>
                  {topic.id === lesson.data.lessonId ? (
                    <span aria-current="page">{topic.title}</span>
                  ) : (
                    <a href={`/${locale}/lessons/${topic.id}/`}>
                      {topic.title}
                    </a>
                  )}
                  <span
                    class="completion-badge"
                    data-completion-badge={topic.id}
                    hidden
                  >
                    ✓ {completionCopy[locale].completed}
                  </span>
                </span>
              </li>
            ))}
          </ol>
        </nav>
      </details>
      {prerequisites.length > 0 && (
        <nav
          class="lesson-prerequisites"
          aria-label={fr ? 'Prérequis' : 'Prerequisites'}
        >
          <strong>{fr ? 'Prérequis' : 'Prerequisites'}</strong>
          <ul>
            {prerequisites.map(({ id, title }) => (
              <li>
                <a href={`/${locale}/lessons/${id}/`}>{title}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      <div class="reading-geometry">
        <SignalGeometry compact variant={geometryVariant} />
      </div>
      <article class="lesson-prose" data-lesson-id={lesson.data.lessonId}>
        <Content />
        {/^L0[1-8]$/.test(lesson.data.lessonId) && (
          <p>
            <a href={`/${locale}/logic-workshop/`}>
              {workshopCopy.title[locale]} →
            </a>
          </p>
        )}
      </article>
      {lesson.data.lessonId === 'L05' && <ImplicationExplorers />}
      {['L55', 'L56', 'L57'].includes(lesson.data.lessonId) && (
        <p>
          <a class="primary-link" href={`/${locale}/chapters/C04/lzw/`}>
            {locale === 'fr'
              ? 'Mettre en pratique dans l’atelier LZW'
              : 'Practise in the LZW workshop'}{' '}
            →
          </a>
        </p>
      )}
      {lesson.data.lessonId === 'L10' && (
        <p>
          <a href={'/' + locale + '/numbers/'}>
            {locale === 'fr'
              ? 'Guide visuel : familles de nombres'
              : 'Visual guide: number families'}
          </a>
        </p>
      )}
      {glossaryLink && (
        <p>
          <a href={'/' + locale + '/glossary/#' + glossaryLink[0]}>
            {glossaryCopy[locale].nav} : {glossaryLink[1]}
          </a>
        </p>
      )}
      <p class="content-provenance">
        {lesson.data.status === 'pilot' ? text.review : text.reviewExtended} ·
        Version {lesson.data.version}
      </p>
      <LessonCompletion
        locale={locale}
        lessonId={lesson.data.lessonId}
        lessonIds={outline.map((topic) => topic.id)}
      />
      {practiceLessons.includes(lesson.data.lessonId) && (
        <div class="lesson-practice-action">
          <h2>{fr ? 'Exercices de la leçon' : 'Lesson practice'}</h2>
          <p>
            {fr
              ? 'Un compte est nécessaire pour répondre et enregistrer vos résultats.'
              : 'An account is required to answer and save your results.'}
          </p>
          <a
            class="primary-link"
            href={
              '/' + locale + '/lessons/' + lesson.data.lessonId + '/practice/'
            }
          >
            {locale === 'fr' ? 'S’exercer' : 'Practise'} →
          </a>
        </div>
      )}
      <nav
        class="lesson-next"
        aria-label={fr ? 'Suite du parcours' : 'Continue learning'}
      >
        {nextLesson && (
          <a href={`/${locale}/lessons/${nextLesson.id}/`}>
            {fr ? 'Leçon suivante' : 'Next lesson'} · {nextLesson.title} →
          </a>
        )}
        <a class="back-link" href={chapterLink}>
          ← {text.next}
        </a>
      </nav>
      <ReadingNotice locale={locale} />
    </div>
  </main>
</Base>

<style>
  .lesson-switcher {
    max-width: 42rem;
    margin-block: 0 1rem;
    border-block: 1px solid var(--soft-line);
  }
  .lesson-switcher summary {
    min-height: 44px;
    padding: 0.65rem 0.25rem;
    font-weight: 700;
    cursor: pointer;
  }
  .lesson-switcher ol {
    max-height: 22rem;
    margin: 0 0.25rem 0.25rem;
    overflow: auto;
  }
  .lesson-prerequisites {
    margin-block: 1rem;
    max-width: 42rem;
    font-size: 0.9rem;
  }
  .lesson-prerequisites ul {
    padding-inline-start: 1.25rem;
    margin-block: 0.35rem 0;
  }
  .lesson-practice-action {
    border-top: 1px solid var(--soft-line);
    margin-block: 1.5rem;
  }
  .lesson-next {
    border-top: 1px solid var(--soft-line);
    margin-block: 1.5rem;
    padding-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.5rem;
  }
  .lesson-next .back-link {
    margin: 0;
  }
  @media print {
    .lesson-switcher,
    .lesson-prerequisites,
    .lesson-practice-action,
    .lesson-next {
      display: none;
    }
  }
</style>
