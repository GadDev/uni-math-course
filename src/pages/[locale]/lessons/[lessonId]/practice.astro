---
import { getCollection, render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import PracticeActivity from '../../../../components/PracticeActivity';
import SignalGeometry from '../../../../components/SignalGeometry.astro';
import { copy } from '../../../../lib/i18n';
import { localeOf } from '../../../../lib/auth/policy';
import { isReviewed, RELEASED_LESSONS } from '../../../../lib/released-lessons';
import '../../../../styles/practice.css';
import '../../../../styles/practice-feedback.css';
// On demand: practice needs a signed-in learner. The page imports no answers.
export const prerender = false;
const lessonId = Astro.params.lessonId ?? '';
if (
  !['fr', 'en'].includes(Astro.params.locale ?? '') ||
  !RELEASED_LESSONS.includes(lessonId)
)
  return new Response('Not found', { status: 404 });
const locale = localeOf(Astro.params.locale);
const auth = Astro.locals.auth;
if (!auth) return new Response('Sign-in is not configured.', { status: 503 });
let user = null;
try {
  user = await auth.verifiedUser();
} catch {
  return new Response('Sign-in is unavailable.', { status: 503 });
}
if (!user)
  return Astro.redirect(
    `/${locale}/sign-in/?${new URLSearchParams({ next: `/${locale}/lessons/${lessonId}/practice/` })}`,
    303,
  );
const text = copy[locale];
const lessons = await getCollection('lessons');
const lesson = lessons.find(
  (entry) => entry.data.locale === locale && entry.data.lessonId === lessonId,
);
if (!lesson) throw new Error('Missing lesson for practice page');
const releasedIds = new Set(
  lessons
    .filter((entry) => entry.data.locale === locale)
    .map((entry) => entry.data.lessonId),
);
// Not every lesson has a section titled as a guided example; fall back to the lesson.
const { headings } = await render(lesson);
const example = headings.find(
  (heading) =>
    heading.depth === 2 &&
    /^(exemple guidé|guided example)/i.test(heading.text),
);
const lessonHref = `/${locale}/lessons/${lessonId}/`;
const topic = text.programme.find((item) => item.id === lessonId);
const lessonNumber = lessonId.slice(1);
---

<Base
  locale={locale}
  title={`${topic?.title ?? lessonId} · ${locale === 'fr' ? 'Pratique' : 'Practice'}`}
  description={lesson.data.summary}
  path={`lessons/${lessonId}/practice/`}
>
  <main id="main" tabindex="-1" class="lesson-page practice-page">
    <aside class="course-outline">
      <p class="eyebrow">
        {lessonNumber} / {topic?.title}
      </p>
      <p class="outline-big" aria-hidden="true">
        {lessonNumber}
      </p>
      <ol class="outline-topics" aria-label={text.outline}>
        {text.programme.map((item) => (
          <li
            class={item.id === lessonId ? 'current-topic' : undefined}
            aria-current={item.id === lessonId ? 'page' : undefined}
          >
            <span class="outline-number">{item.id.slice(1)}</span>
            <span>
              {releasedIds.has(item.id) && item.id !== lessonId ? (
                <a href={`/${locale}/lessons/${item.id}/`}>{item.title}</a>
              ) : (
                item.title
              )}
              {!releasedIds.has(item.id) && <small>{text.planned}</small>}
            </span>
          </li>
        ))}
      </ol>
    </aside>
    <div class="reading-column practice-column">
      <div class="practice-geometry">
        <SignalGeometry compact />
      </div>
      <PracticeActivity
        client:load
        lessonId={lessonId}
        locale={locale}
        lessonNumber={lessonNumber}
        exampleHref={example ? `${lessonHref}#${example.slug}` : lessonHref}
        hasExample={!!example}
        extended={!isReviewed(lessonId)}
      />
    </div>
  </main>
</Base>
