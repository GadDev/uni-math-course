---
import Base from '../../layouts/Base.astro';
import { authCopy } from '../../lib/auth/copy';
import { localeOf } from '../../lib/auth/policy';

export const prerender = false;
if (!['fr', 'en'].includes(Astro.params.locale ?? ''))
  return new Response('Not found', { status: 404 });
const locale = localeOf(Astro.params.locale);
const text = authCopy[locale];
const auth = Astro.locals.auth;
const errorCode = Astro.url.searchParams.get('error');
const error =
  errorCode === 'invalid'
    ? text.resetInvalid
    : errorCode === 'expired'
      ? text.recoveryInvalid
      : errorCode === 'unavailable'
        ? text.resetUnavailable
        : null;
---

<Base locale={locale} title={text.resetTitle} description={text.resetIntro} path="reset-password/">
  <main id="main" class="auth-page">
    <p class="eyebrow">{text.forgotPassword}</p>
    <h1>{text.resetTitle}</h1>
    <p class="lede">{text.resetIntro}</p>
    {error && <p class="auth-message" role="alert">{error}</p>}
    <section class="auth-card" aria-label={text.resetTitle}>
      <form method="post" action="/auth/reset-password/" class="auth-form">
        <input type="hidden" name="locale" value={locale} />
        <label for="new-password">{text.newPassword}</label>
        <input id="new-password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required disabled={!auth} />
        <label for="confirm-password">{text.confirmPassword}</label>
        <input id="confirm-password" name="confirm" type="password" autocomplete="new-password" minlength="12" maxlength="128" required disabled={!auth} />
        <button class="primary-link auth-button" type="submit" disabled={!auth}>
          {text.resetSubmit}
        </button>
      </form>
      {!auth && <p role="status">{text.disabled}</p>}
      <p class="auth-note"><a href={`/${locale}/forgot-password/`}>{text.forgotPassword}</a></p>
    </section>
    <a class="back-link" href={`/${locale}/sign-in/`}>{text.backToSignIn}</a>
  </main>
</Base>
