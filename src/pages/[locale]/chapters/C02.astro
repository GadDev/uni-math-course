---
import Base from '../../../layouts/Base.astro';
import SignalGeometry from '../../../components/SignalGeometry.astro';
import { locales } from '../../../lib/i18n';
import { droitesCopy } from '../../../lib/droites';
import katex from 'katex';
import { getCollection } from 'astro:content';
import { droitesGroups } from '../../../lib/droites-lessons';
import '../../../styles/chapter-overview.css';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props;
const text = droitesCopy[locale];
const lessons = (await getCollection('lessons')).filter(
  (entry) => entry.data.locale === locale,
);
const lessonData = (id: string) => {
  const entry = lessons.find((entry) => entry.data.lessonId === id);
  if (!entry) throw new Error(`Missing Chapter 2 lesson ${id}`);
  return entry.data;
};
const formula = katex.renderToString('a(b+c)=ab+ac', {
  output: 'htmlAndMathml',
  throwOnError: true,
});
---

<Base
  locale={locale}
  title={text.title}
  description={text.intro}
  path="chapters/C02/"
>
  <main id="main" tabindex="-1" class="chapter-overview" data-chapter="C02">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">{text.eyebrow}</p>
        <h1 class="signal-title">
          {text.title}
          <span class="signal-stop">.</span>
        </h1>
        <p class="chapter-subtitle">
          {text.subtitle.map((line) => (
            <span>{line}</span>
          ))}
        </p>
        <p class="lede">{text.intro}</p>
        <p class="status">{text.status}</p>
        <p class="chapter-motto">{text.motto}</p>
      </div>
      <div class="hero-art">
        <SignalGeometry variant="decalage" />
      </div>
    </section>
    <section class="lesson-feature" aria-labelledby="algebra-title">
      <div class="lesson-index" aria-hidden="true">
        01
      </div>
      <div class="featured-identity">
        <p class="eyebrow">{text.start}</p>
        <h2 id="algebra-title">{text.algebra}</h2>
        <div class="feature-formula" set:html={formula} />
        <p class="visually-hidden">{text.formulaReading}</p>
        <p class="formula-reading">{text.rules}</p>
      </div>
      <div class="featured-description">
        <p>{text.description}</p>
        <div class="lesson-meta">
          <span>
            {lessonData('L21').minutes} min · 15{' '}
            {locale === 'fr' ? 'exercices' : 'exercises'}
          </span>
        </div>
      </div>
      <div class="featured-action">
        <a class="primary-link" href={`/${locale}/lessons/L21/`}>
          {locale === 'fr' ? 'Lire la leçon' : 'Read the lesson'}
          <span aria-hidden="true"> →</span>
        </a>
      </div>
    </section>
    <section
      class="planned-section"
      id="parcours"
      aria-labelledby="outline-title"
    >
      <div class="chapter-section-heading">
        <h2 id="outline-title">{text.outline}</h2>
        <p>{text.outlineNote}</p>
      </div>
      {droitesGroups.map((group) => (
        <section class="chapter-lesson-group">
          <h3>{group.title[locale]}</h3>
          <ol class="planned-list chapter-lessons">
            {group.lessonIds.map((id) => (
              <li class="available-topic">
                <span class="planned-number" aria-hidden="true">
                  {Number(id.slice(1)) - 20 < 10 ? '0' : ''}
                  {Number(id.slice(1)) - 20}
                </span>
                <a href={`/${locale}/lessons/${id}/`}>{lessonData(id).title}</a>
                <small class="planned-label">
                  {lessonData(id).minutes} min · 15{' '}
                  {locale === 'fr' ? 'exercices' : 'exercises'}
                </small>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </section>
    <section class="chapter-objectives" aria-labelledby="objectives-title">
      <h2 id="objectives-title">{text.goals}</h2>
      <ol>
        {text.objectives.map((objective) => (
          <li>{objective}</li>
        ))}
      </ol>
    </section>
    <section class="practice-status" aria-labelledby="practice-title">
      <div class="practice-copy">
        <h2 id="practice-title">{text.practice}</h2>
        <p>{text.practiceText}</p>
        <a class="primary-link" href={`/${locale}/lessons/L21/practice/`}>
          {text.exercises}
        </a>
      </div>
      <aside class="reading-notice" aria-labelledby="chapter-progress-title">
        <h2 id="chapter-progress-title" class="reading-notice-title">
          {text.progress}
        </h2>
        <p>{text.progressText}</p>
        <a href={`/${locale}/progress/#chapter-C02`}>
          {locale === 'fr' ? 'Voir ma progression' : 'View my progress'} →
        </a>
      </aside>
    </section>
  </main>
</Base>
