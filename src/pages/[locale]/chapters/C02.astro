---
import ProgrammeDashboard from '../../../components/ProgrammeDashboard.astro';
import { completionCopy } from '../../../lib/completion-copy';
import TrainingExamLink from '../../../components/TrainingExamLink.astro';
import Base from '../../../layouts/Base.astro';
import SignalGeometry from '../../../components/SignalGeometry.astro';
import { locales } from '../../../lib/i18n';
import { droitesCopy } from '../../../lib/droites';
import katex from 'katex';
import { getCollection } from 'astro:content';
import { droitesGroups } from '../../../lib/droites-lessons';
import '../../../styles/chapter-overview.css';
import '../../../styles/droites-teaching.css';
import DroitesSourcePath from '../../../components/DroitesSourcePath.astro';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props;
const text = droitesCopy[locale];
const lessons = (await getCollection('lessons')).filter(
  (entry) => entry.data.locale === locale,
);
const lessonData = (id: string) => {
  const entry = lessons.find((entry) => entry.data.lessonId === id);
  if (!entry) throw new Error(`Missing Chapter 2 lesson ${id}`);
  return entry.data;
};
const formula = katex.renderToString('a(b+c)=ab+ac', {
  output: 'htmlAndMathml',
  throwOnError: true,
});
---

<Base
  locale={locale}
  title={text.title}
  description={text.intro}
  path="chapters/C02/"
>
  <main id="main" tabindex="-1" class="chapter-overview" data-chapter="C02">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">{text.eyebrow}</p>
        <h1 class="signal-title">
          {text.title}
          <span class="signal-stop">.</span>
        </h1>
        <p class="chapter-subtitle">
          {text.subtitle.map((line) => (
            <span>{line}</span>
          ))}
        </p>
        <p class="lede">{text.intro}</p>
        <p class="status">{text.status}</p>
        <p class="chapter-motto">{text.motto}</p>
      </div>
      <div class="hero-art">
        <SignalGeometry variant="decalage" />
      </div>
    </section>
    <section
      class="planned-section programme-section"
      id="parcours"
      aria-labelledby="outline-title"
    >
      <ProgrammeDashboard
        locale={locale}
        chapterId="C02"
        objectives={text.objectives}

        chapterTitle={text.title}
        headingId="outline-title"
        title={text.outline}
        intro={
          locale === 'fr'
            ? 'Cinq étapes pour calculer, tracer et modéliser. Retrouvez les 16 leçons et avancez à votre rythme.'
            : 'Five stages to calculate, plot and model. Explore all 16 lessons and work at your own pace.'
        }
        lessons={droitesGroups.flatMap((group) =>
          group.lessonIds.map((id) => ({ id, title: lessonData(id).title })),
        )}
        action={{
          title:
            locale === 'fr'
              ? 'Un examen blanc sur les droites'
              : 'A straight-lines mock exam',
          description:
            locale === 'fr'
              ? 'Reliez les méthodes du chapitre dans un sujet de 20 questions. Comptez environ 60 minutes ; connectez-vous pour répondre.'
              : 'Bring the chapter’s methods together in a 20-question paper. Allow around 60 minutes; sign in to answer.',
          href: `/${locale}/training-exams/#C02`,
          label:
            locale === 'fr'
              ? 'Préparer un examen blanc'
              : 'Prepare a mock exam',
        }}
        jumps={droitesGroups.map((group, index) => ({
          href: `#programme-C02-part-${index + 1}`,
          label: group.title[locale],
        }))}
      >
        {droitesGroups.map((group, index) => (
          <section
            class="chapter-lesson-group programme-part"
            id={`programme-C02-part-${index + 1}`}
            aria-labelledby={`programme-C02-heading-${index + 1}`}
          >
            <h3 id={`programme-C02-heading-${index + 1}`}>
              {group.title[locale]}
            </h3>
            <p class="programme-source">
              {group.lessonIds.length}{' '}
              {locale === 'fr'
                ? Number(group.lessonIds.length) === 1
                  ? 'leçon'
                  : 'leçons'
                : Number(group.lessonIds.length) === 1
                  ? 'lesson'
                  : 'lessons'}
            </p>
            <ol class="planned-list chapter-lessons">
              {group.lessonIds.map((id) => (
                <li class="available-topic">
                  <span class="planned-number" aria-hidden="true">
                    {Number(id.slice(1)) - 20 < 10 ? '0' : ''}
                    {Number(id.slice(1)) - 20}
                  </span>
                  <a href={`/${locale}/lessons/${id}/`}>
                    {lessonData(id).title}
                    <span
                      class="completion-badge"
                      data-completion-badge={id}
                      hidden
                    >
                      ✓ {completionCopy[locale].completed}
                    </span>
                  </a>
                  <small class="planned-label">
                    {lessonData(id).minutes} min · 15{' '}
                    {locale === 'fr' ? 'exercices' : 'exercises'}
                  </small>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </ProgrammeDashboard>
    </section>
    <DroitesSourcePath locale={locale} />
    <section class="practice-status" aria-labelledby="practice-title">
      <div class="practice-copy">
        <h2 id="practice-title">{text.practice}</h2>
        <p>{text.practiceText}</p>
        <a class="primary-link" href={`/${locale}/lessons/L21/practice/`}>
          {text.exercises}
        </a>
      </div>
      <aside class="reading-notice" aria-labelledby="chapter-progress-title">
        <h2 id="chapter-progress-title" class="reading-notice-title">
          {text.progress}
        </h2>
        <p>{text.progressText}</p>
        <a href={`/${locale}/progress/#chapter-C02`}>
          {locale === 'fr' ? 'Voir ma progression' : 'View my progress'} →
        </a>
      </aside>
    </section>
    <TrainingExamLink locale={locale} chapterId="C02" />
    <section class="lesson-feature" aria-labelledby="algebra-title">
      <div class="lesson-index" aria-hidden="true">
        01
      </div>
      <div class="featured-identity">
        <p class="eyebrow">{text.start}</p>
        <h2 id="algebra-title">{text.algebra}</h2>
        <div class="feature-formula" set:html={formula} />
        <p class="visually-hidden">{text.formulaReading}</p>
        <p class="formula-reading">{text.rules}</p>
      </div>
      <div class="featured-description">
        <p>{text.description}</p>
        <div class="lesson-meta">
          <span>
            {lessonData('L21').minutes} min · 15{' '}
            {locale === 'fr' ? 'exercices' : 'exercises'}
          </span>
        </div>
      </div>
      <div class="featured-action">
        <a class="primary-link" href={`/${locale}/lessons/L21/`}>
          {locale === 'fr' ? 'Lire la leçon' : 'Read the lesson'}
          <span aria-hidden="true"> →</span>
        </a>
      </div>
    </section>
  </main>
</Base>
