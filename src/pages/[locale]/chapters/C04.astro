---
import Base from '../../../layouts/Base.astro';
import SignalGeometry from '../../../components/SignalGeometry.astro';
import ProgrammeDashboard from '../../../components/ProgrammeDashboard.astro';
import { completionCopy } from '../../../lib/completion-copy';
import { informationCopy } from '../../../lib/information';
import { locales } from '../../../lib/i18n';
import katex from 'katex';
import '../../../styles/chapter-overview.css';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props;
const text = informationCopy[locale];
const lessonGroups = [
  {
    title: locale === 'fr' ? 'Codes et messages' : 'Codes and messages',
    start: 1,
    lessons: text.lessons.slice(0, 3),
  },
  {
    title:
      locale === 'fr'
        ? 'Probabilités et compression'
        : 'Probability and compression',
    start: 4,
    lessons: text.lessons.slice(3, 7),
  },
  {
    title:
      locale === 'fr' ? 'Arbres, bornes et blocs' : 'Trees, bounds and blocks',
    start: 8,
    lessons: text.lessons.slice(7),
  },
];
const formula = katex.renderToString(String.raw`c:S\to\{0,1\}^{*}`, {
  output: 'htmlAndMathml',
  throwOnError: true,
});
---

<Base
  locale={locale}
  title={text.title}
  description={text.intro}
  path="chapters/C04/"
>
  <main id="main" tabindex="-1" class="chapter-overview" data-chapter="C04">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">{text.eyebrow}</p>
        <h1 class="signal-title">
          <span>{text.titleLines[0]}</span>
          <span>
            {text.titleLines[1]}
            <span class="signal-stop">.</span>
          </span>
        </h1>
        <p class="chapter-subtitle">
          {text.subtitle.map((line) => (
            <span>{line}</span>
          ))}
        </p>
        <p class="lede">{text.intro}</p>
        <p class="status">{text.status}</p>
        <p class="chapter-motto">{text.motto}</p>
      </div>
      <div class="hero-art">
        <SignalGeometry variant="ember" />
      </div>
    </section>

    <section class="lesson-feature" aria-labelledby="information-basics-title">
      <div class="lesson-index" aria-hidden="true">
        01
      </div>
      <div class="featured-identity">
        <p class="eyebrow">{text.start}</p>
        <h2 id="information-basics-title">{text.basics}</h2>
        <div class="feature-formula" set:html={formula} />
        <p class="visually-hidden">{text.formulaReading}</p>
        <p class="formula-reading">{text.formulaCaption}</p>
      </div>
      <div class="featured-description">
        <p>{text.description}</p>
        <div class="lesson-meta">
          <span>{text.upcoming}</span>
        </div>
      </div>
      <div class="featured-action">
        <a class="primary-link" href={`/${locale}/lessons/L43/`}>
          {text.explore}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <section
      id="parcours"
      class="planned-section programme-section"
      aria-labelledby="information-outline"
    >
      <ProgrammeDashboard
        locale={locale}
        chapterNumber="04"
        chapterTitle={text.title}
        headingId="information-outline"
        title={text.outline}
        intro={
          locale === 'fr'
            ? 'Des messages binaires aux bornes de Shannon : douze leçons pour comprendre et mesurer la compression, étape par étape.'
            : 'From binary messages to Shannon’s bounds: twelve lessons to understand and measure compression, step by step.'
        }
        lessons={text.lessons}
        action={{
          title: locale === 'fr' ? 'Coder avec Huffman' : 'Huffman coding',
          description:
            locale === 'fr'
              ? 'Explorez un arbre de Huffman et comparez les longueurs des codes dans la leçon interactive.'
              : 'Explore a Huffman tree and compare codeword lengths in the interactive lesson.',
          href: `/${locale}/lessons/L49/`,
          label: locale === 'fr' ? 'Explorer le codage' : 'Explore coding',
        }}
        jumps={lessonGroups.map((group, index) => ({
          href: `#programme-C04-part-${index + 1}`,
          label: group.title,
        }))}
      />
      {lessonGroups.map((group, groupIndex) => (
        <section
          class="chapter-lesson-group programme-part"
          id={`programme-C04-part-${groupIndex + 1}`}
          aria-labelledby={`programme-C04-heading-${groupIndex + 1}`}
        >
          <h3 id={`programme-C04-heading-${groupIndex + 1}`}>{group.title}</h3>
          <p class="programme-source">
            {group.lessons.length} {locale === 'fr' ? 'leçons' : 'lessons'}
          </p>
          <ol class="planned-list chapter-lessons" start={group.start}>
            {group.lessons.map((lesson, index) => (
              <li class="available-topic">
                <span class="planned-number" aria-hidden="true">
                  {String(group.start + index).padStart(2, '0')}
                </span>
                <a href={`/${locale}/lessons/${lesson.id}/`}>
                  {lesson.title}
                  <span
                    class="completion-badge"
                    data-completion-badge={lesson.id}
                    hidden
                  >
                    ✓ {completionCopy[locale].completed}
                  </span>
                </a>
                <small class="planned-label">
                  {text.pages} {lesson.pages} · {text.upcoming}
                </small>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </section>

    <section class="practice-status" aria-labelledby="lzw-workshop-title">
      <div class="practice-copy">
        <p class="eyebrow">
          {locale === 'fr'
            ? 'Laboratoire public · L55–L57'
            : 'Public laboratory · L55–L57'}
        </p>
        <h2 id="lzw-workshop-title">
          {locale === 'fr'
            ? 'Construisez votre dictionnaire LZW'
            : 'Build your LZW dictionary'}
        </h2>
        <p>
          {locale === 'fr'
            ? 'Explorez les exemples, complétez une étape à la fois, puis encodez et décodez des messages en autonomie.'
            : 'Explore examples, complete one step at a time, then encode and decode messages independently.'}
        </p>
        <a class="primary-link" href={`/${locale}/chapters/C04/lzw/`}>
          {locale === 'fr' ? 'Ouvrir l’atelier LZW' : 'Open the LZW workshop'} →
        </a>
      </div>
    </section>

    <section class="chapter-objectives" aria-labelledby="information-goals">
      <h2 id="information-goals">{text.goals}</h2>
      <ol>
        {text.objectives.map((objective) => (
          <li>{objective}</li>
        ))}
      </ol>
    </section>

    <section class="practice-status" aria-labelledby="information-practice">
      <div class="practice-copy">
        <h2 id="information-practice">{text.practice}</h2>
        <p>{text.practiceText}</p>
      </div>
      <aside class="reading-notice" aria-labelledby="information-review">
        <h2 id="information-review" class="reading-notice-title">
          {text.review}
        </h2>
        <p>{text.reviewText}</p>
      </aside>
    </section>
  </main>
</Base>
