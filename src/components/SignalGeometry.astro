---
interface Props {
  compact?: boolean;
  variant?: 'logic' | 'decalage' | 'ember';
}
const { compact = false, variant = 'logic' } = Astro.props;
---

<svg
  class:list={['signal-geometry', { 'signal-geometry-compact': compact }]}
  data-variant={variant}
  viewBox="0 0 560 560"
  aria-hidden="true"
  focusable="false"
>
  {variant === 'decalage' ? (
    <g>
      <rect width="560" height="560" fill="var(--paper)" />
      <path d="M0 0H140V280H0Z" fill="var(--ink)" />
      <path d="M140 0H280V140H140Z" fill="var(--signal-red)" />
      <path d="M420 0A140 140 0 0 1 560 140H420Z" fill="var(--signal-red)" />
      <path d="M420 140A140 140 0 0 0 280 280H420Z" fill="var(--ink)" />
      <path d="M140 140L280 280H140Z" fill="var(--signal-red)" />
      <path d="M0 280H140V420H280V560H140V420H0Z" fill="var(--signal-red)" />
      <path d="M280 280H420V420H560V560H420V420H280Z" fill="var(--ink)" />
      <path d="M420 280H560V420Z" fill="var(--signal-red)" />
      <path d="M0 560A140 140 0 0 1 140 420V560Z" fill="var(--ink)" />
      <path
        d="M0 140H560M280 0V560"
        fill="none"
        stroke="var(--ink)"
        stroke-width="1"
      />
      <path
        d="M0 280A280 280 0 0 1 280 0M280 560A280 280 0 0 1 560 280"
        fill="none"
        stroke="var(--ink)"
        stroke-width="1.5"
        stroke-dasharray="6 7"
      />
    </g>
  ) : variant === 'ember' ? (
  <g>
    <rect width="560" height="560" fill="var(--paper)" />

    <path d="M0 0h140v140H0Z" fill="var(--ink)" />
    <circle cx="210" cy="70" r="70" fill="var(--signal-red)" />
    <path d="M280 0h140v140H280Z" fill="var(--ink)" />
    <path d="M420 0h140v140H420Z" fill="var(--signal-red)" />

    <path d="M0 140h140v140H0Z" fill="var(--signal-red)" />
    <path d="M140 280V140h140Z" fill="var(--ink)" />
    <circle cx="350" cy="210" r="70" fill="var(--signal-red)" />
    <path d="M420 140h140v140H420Z" fill="var(--ink)" />
    <path d="M420 140a140 140 0 0 1 140 140H420Z" fill="var(--signal-red)" />

    <circle cx="70" cy="350" r="70" fill="var(--ink)" />
    <path d="M140 280h140v140H140Z" fill="var(--signal-red)" />
    <path d="M280 280h140v140H280Z" fill="var(--ink)" />
    <path d="M420 280h140v140H420Z" fill="var(--signal-red)" />
    <path d="M420 420a140 140 0 0 1 140-140v140Z" fill="var(--ink)" />

    <path d="M0 420h140v140H0Z" fill="var(--signal-red)" />
    <path d="M140 420h140v140H140Z" fill="var(--ink)" />
    <circle cx="350" cy="490" r="70" fill="var(--signal-red)" />
    <path d="M420 420h140v140H420Z" fill="var(--ink)" />
    <path d="M420 560a140 140 0 0 1 140-140v140Z" fill="var(--signal-red)" />

    <path
      d="M0 140H560M0 280H560M0 420H560M140 0V560M280 0V560M420 0V560"
      stroke="var(--ink)"
      stroke-width="1"
      fill="none"
    />
    <path
      d="M70 70H490M70 490H490M70 70V490M490 70V490"
      stroke="var(--ink)"
      stroke-width="1.5"
      stroke-dasharray="6 8"
      fill="none"
    />
  </g>
  ) : (
    <g>
      <circle cx="416" cy="145" r="126" fill="var(--signal-red)" />
      <path d="M416 19a126 126 0 0 0 0 252Z" fill="var(--ink)" />
      <path d="M280 0h136v280H280Z" fill="var(--ink)" />
      <path d="M0 0h154l406 406v154Z" fill="var(--signal-red)" />
      <path
        d="M0 420h140V280Zm140 0v140h140V420Zm280 0v140h140Z"
        fill="var(--ink)"
      />
      <path d="M0 560a140 140 0 0 1 140-140v140Z" fill="var(--signal-red)" />
      <path
        d="M280 0v560M0 280h560"
        fill="none"
        stroke="var(--ink)"
        stroke-width="1"
      />
      <path
        d="M86 222h116m-18-12 18 12-18 12M306 472h188m-18-12 18 12-18 12M510 182V84m-12 18 12-18 12 18"
        fill="none"
        stroke="var(--ink)"
        stroke-width="2.5"
      />
      <path
        d="M140 560a140 140 0 0 1 280-140M416 145a170 170 0 0 1 94 273"
        fill="none"
        stroke="var(--ink)"
        stroke-width="1.5"
        stroke-dasharray="7 7"
      />
      <circle cx="280" cy="280" r="10" fill="#edfa44" />
    </g>
  )}
</svg>
