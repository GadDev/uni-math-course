---
import '../styles/implication-explorers.css';
---

<script>
  import { challengeValue, implicationValues } from '../lib/implication';

  const fr = document.documentElement.lang === 'fr';
  const bit = (value: boolean) => String(Number(value));
  const truth = (value: boolean) =>
    fr ? (value ? 'vrai' : 'faux') : value ? 'true' : 'false';

  for (const lab of document.querySelectorAll<HTMLElement>(
    '[data-logic-lab]',
  )) {
    const aInput = lab.querySelector<HTMLSelectElement>('[data-a]')!;
    const bInput = lab.querySelector<HTMLSelectElement>('[data-b]')!;
    const put = (key: string, value: string) => {
      const target = lab.querySelector<HTMLElement>(`[data-${key}]`);
      if (target) target.textContent = value;
    };
    const update = () => {
      const a = aInput.value === '1';
      const b = bInput.value === '1';
      const values = implicationValues(a, b);
      put(
        'calculation',
        `¬A ∨ B = ${bit(!a)} ∨ ${bit(b)} = ${bit(values.implication)}`,
      );
      put(
        'implication',
        `A ⇒ B : ${truth(values.implication)} (${bit(values.implication)})`,
      );
      put(
        'negation',
        `¬(A ⇒ B) : ${truth(values.negation)} (${bit(values.negation)})`,
      );
      put(
        'operands',
        `¬A ⇒ ¬B : ${truth(values.negatedOperands)} (${bit(values.negatedOperands)})`,
      );
      put(
        'failure',
        `A ∧ ¬B = ${bit(a)} ∧ ${bit(!b)} = ${bit(values.negation)}`,
      );
      put(
        'card',
        fr
          ? `Carte ${a ? 'rouge' : 'bleue'}, ${b ? 'avec' : 'sans'} tampon.`
          : `${a ? 'Red' : 'Blue'} card, ${b ? 'with' : 'without'} a stamp.`,
      );
      const card = lab.querySelector<HTMLElement>('[data-card]');
      if (card) card.dataset.colour = a ? 'red' : 'blue';
      put(
        'reason',
        a
          ? b
            ? fr
              ? 'A est vraie et B est vraie : la carte respecte la règle.'
              : 'A is true and B is true: the card respects the rule.'
            : fr
              ? 'A est vraie et B est fausse : cette carte est un contre-exemple.'
              : 'A is true and B is false: this card is a counterexample.'
          : fr
            ? 'A est fausse : cette carte ne contredit pas la règle, quel que soit le tampon. Cela ne prouve pas la règle pour toutes les cartes.'
            : 'A is false: this card does not contradict the rule, whatever the stamp. This does not prove the rule for all cards.',
      );
      put(
        'comparison',
        values.negation === values.negatedOperands
          ? fr
            ? '¬(A ⇒ B) et ¬A ⇒ ¬B ont la même valeur ici. Il faut comparer les quatre cas pour décider d’une équivalence.'
            : '¬(A ⇒ B) and ¬A ⇒ ¬B have the same value here. Compare all four cases to decide whether the formulas are equivalent.'
          : fr
            ? '¬(A ⇒ B) et ¬A ⇒ ¬B ont des valeurs différentes ici : ces formules ne sont donc pas équivalentes.'
            : '¬(A ⇒ B) and ¬A ⇒ ¬B have different values here, so these formulas are not equivalent.',
      );
      if (lab.dataset.logicLab === 'cards') {
        const rows = document.querySelectorAll<HTMLTableRowElement>(
          '.lesson-prose > table:first-of-type tbody tr',
        );
        rows.forEach((row, index) => {
          if (index === Number(a) * 2 + Number(b))
            row.setAttribute('aria-current', 'true');
          else row.removeAttribute('aria-current');
        });
      }
    };
    for (const input of [aInput, bInput]) {
      input.disabled = false;
      input.addEventListener('change', update);
    }
    update();
  }

  for (const lab of document.querySelectorAll<HTMLElement>(
    '[data-number-lab]',
  )) {
    const slider = lab.querySelector<HTMLInputElement>('input')!;
    const update = () => {
      const n = Number(slider.value);
      const a = n > 10,
        b = n > 5;
      lab.querySelector<HTMLOutputElement>('output')!.value = String(n);
      const marker = lab.querySelector<SVGLineElement>('[data-marker]')!;
      const x = 30 + n * 28;
      marker.setAttribute('x1', String(x));
      marker.setAttribute('x2', String(x));
      lab.querySelector<HTMLElement>('[data-number-result]')!.textContent = fr
        ? `n = ${n} : A (« n > 10 ») : ${truth(a)} ; B (« n > 5 ») : ${truth(b)}. A ⇒ B vaut ${bit(implicationValues(a, b).implication)} ; B ⇒ A vaut ${bit(implicationValues(b, a).implication)}. ${b && !a ? 'Ce nombre réfute la réciproque B ⇒ A.' : 'Ce nombre ne réfute pas la réciproque. Cherchez entre les deux seuils.'}`
        : `n = ${n}: A (“n > 10”) is ${truth(a)}; B (“n > 5”) is ${truth(b)}. A ⇒ B is ${bit(implicationValues(a, b).implication)}; B ⇒ A is ${bit(implicationValues(b, a).implication)}. ${b && !a ? 'This number refutes the converse B ⇒ A.' : 'This number does not refute the converse. Look between the two thresholds.'}`;
    };
    slider.disabled = false;
    slider.addEventListener('input', update);
    update();
  }

  for (const lab of document.querySelectorAll<HTMLElement>(
    '[data-implication-challenge]',
  )) {
    const controls = lab.querySelector<HTMLFieldSetElement>(
      '[data-challenge-controls]',
    )!;
    const task = lab.querySelector<HTMLSelectElement>('[data-task]')!;
    const aInput = lab.querySelector<HTMLSelectElement>('[data-challenge-a]')!;
    const bInput = lab.querySelector<HTMLSelectElement>('[data-challenge-b]')!;
    const prediction = lab.querySelector<HTMLSelectElement>('[data-prediction]')!;
    const label = lab.querySelector<HTMLElement>('[data-prediction-label]')!;
    const check = lab.querySelector<HTMLButtonElement>(
      '[data-challenge-check]',
    )!;
    const feedback = lab.querySelector<HTMLElement>(
      '[data-challenge-feedback]',
    )!;
    const refresh = () => {
      label.hidden = task.value !== 'predict';
      prediction.disabled = task.value !== 'predict';
      prediction.value = '';
      feedback.textContent = '';
      check.disabled = task.value === 'predict';
    };
    for (const input of [task, aInput, bInput]) {
      input.addEventListener('change', refresh);
    }
    prediction.addEventListener('change', () => {
      feedback.textContent = '';
      check.disabled = prediction.value === '';
    });
    check.addEventListener('click', () => {
      const a = aInput.value === '1';
      const b = bInput.value === '1';
      const reverse = task.value === 'converse';
      const antecedent = reverse ? b : a;
      const consequent = reverse ? a : b;
      const value = challengeValue(task.value, a, b);
      const correct =
        task.value === 'predict' ? prediction.value === bit(value) : !value;
      const rule = reverse ? 'B ⇒ A' : 'A ⇒ B';
      const reason = !antecedent
        ? fr
          ? 'La condition est fausse : aucun échec.'
          : 'The antecedent is false: no violation.'
        : consequent
          ? fr
            ? 'La condition et la conclusion sont vraies.'
            : 'Both antecedent and consequent are true.'
          : fr
            ? 'La condition est vraie et la conclusion est fausse.'
            : 'The antecedent is true and the consequent is false.';
      feedback.textContent =
        (correct
          ? fr
            ? 'Bonne réponse. '
            : 'Correct. '
          : fr
            ? 'À revoir. '
            : 'Try again. ') +
        rule +
        ' = ' +
        bit(value) +
        '. ' +
        reason;
    });
    lab
      .querySelector<HTMLButtonElement>('[data-challenge-reset]')!
      .addEventListener('click', () => {
        task.value = 'predict';
        aInput.value = '0';
        bInput.value = '0';
        refresh();
      });
    controls.disabled = false;
    lab.dataset.ready = 'true';
    refresh();
  }
</script>
