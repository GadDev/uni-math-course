---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import '../styles/profile-menu.css';
import '../styles/chapters.css';
import ChapterSelector from '../components/ChapterSelector.astro';
import { chapterForPath } from '../lib/chapters';
import { copy, type Locale } from '../lib/i18n';
import { glossaryCopy } from '../lib/glossary';
import { authCopy } from '../lib/auth/copy';
import { progressCopy } from '../lib/progress-copy';
interface Props {
  locale: Locale;
  title: string;
  description: string;
  path?: string;
  alternateHref?: string;
  alternateAnchors?: Record<string, string>;
}
const {
  locale,
  title,
  description,
  path = '',
  alternateHref,
  alternateAnchors = {},
} = Astro.props;
const text = copy[locale];
const alternate = locale === 'fr' ? 'en' : 'fr';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} · Uni Math Course</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/anton-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      // Hide "Sign in" up front when a session may exist, to avoid a flash.
      if (/(?:^|; )um-session=1/.test(document.cookie))
        document.documentElement.classList.add('has-session-hint');
    </script>
    <link rel="alternate" hreflang="fr" href={'/fr/' + path} />
    <link rel="alternate" hreflang="en" href={'/en/' + path} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {text.skip}
    </a>
    <header class="site-header" data-chapter={chapterForPath(path)?.id}>
      <a class="brand" href={'/' + locale + '/'}>
        <span>{text.brand}</span>
      </a>
      <nav class="primary-nav" aria-label={text.navigation}>
        <ChapterSelector locale={locale} path={path} />
        <a
          href={'/' + locale + '/glossary/'}
          aria-current={path === 'glossary/' ? 'page' : undefined}
        >
          {glossaryCopy[locale].nav}
        </a>
        <a
          href={'/' + locale + '/numbers/'}
          aria-current={path === 'numbers/' ? 'page' : undefined}
        >
          {locale === 'fr' ? 'Nombres' : 'Numbers'}
        </a>
      </nav>
      <div class="header-actions">
        <nav aria-label={text.language} class="language-switch">
          <span lang={locale} aria-current="page">
            {locale.toUpperCase()}
          </span>
          <span class="language-divider" aria-hidden="true">
            /
          </span>
          <a
            lang={alternate}
            hreflang={alternate}
            href={alternateHref ?? '/' + alternate + '/' + path}
            data-language-link
            data-alternate-anchors={JSON.stringify(alternateAnchors)}
            title={alternate === 'en' ? 'English' : 'Français'}
          >
            {alternate.toUpperCase()}
          </a>
        </nav>
        <a class="header-sign-in" href={'/' + locale + '/sign-in/'}>
          {locale === 'fr' ? 'Connexion' : authCopy[locale].signIn}
        </a>
        <div class="profile-menu" data-profile-menu hidden>
          <button
            type="button"
            class="profile-button"
            aria-expanded="false"
            aria-controls="profile-panel"
            aria-label={authCopy[locale].account}
          >
            <svg
              viewBox="0 0 24 24"
              width="22"
              height="22"
              aria-hidden="true"
              focusable="false"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="8" r="4"></circle>
              <path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"></path>
            </svg>
          </button>
          <div id="profile-panel" class="profile-panel" hidden>
            <a href={'/' + locale + '/account/'}>{authCopy[locale].account}</a>
            <a href={'/' + locale + '/progress/'}>{progressCopy[locale].nav}</a>
            <form method="post" action="/auth/logout/">
              <input type="hidden" name="locale" value={locale} />
              <button type="submit">{authCopy[locale].signOutShort}</button>
            </form>
          </div>
        </div>
      </div>
    </header>
    <div class="page">
      <slot />
    </div>
    <footer class="site-footer">
      <p>{text.footer}</p>
      <p>
        © 2026 · <a href="https://github.com/GadDev/uni-math-course">GadDev</a>
      </p>
    </footer>
    <script>
      import {
        clearPracticeDrafts,
        startSessionLifecycle,
      } from '../lib/session-lifecycle';
      startSessionLifecycle();
      // Drafts can contain learner responses. Clear them before a normal logout
      // navigation, including drafts for lessons not currently open.
      document
        .querySelectorAll('form[action="/auth/logout/"]')
        .forEach((form) => {
          form.addEventListener('submit', clearPracticeDrafts);
        });
      const menu = document.querySelector<HTMLElement>('[data-profile-menu]');
      const button = menu?.querySelector<HTMLButtonElement>('.profile-button');
      const panel = menu?.querySelector<HTMLElement>('.profile-panel');
      const setOpen = (open: boolean) => {
        if (!button || !panel) return;
        button.setAttribute('aria-expanded', String(open));
        panel.hidden = !open;
      };
      if (menu && button && panel) {
        button.addEventListener('click', () =>
          setOpen(button.getAttribute('aria-expanded') !== 'true'),
        );
        document.addEventListener('click', (event) => {
          if (!menu.contains(event.target as Node)) setOpen(false);
        });
        menu.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && !panel.hidden) {
            setOpen(false);
            button.focus();
          }
        });
        menu.addEventListener('focusout', (event) => {
          if (!menu.contains(event.relatedTarget as Node | null))
            setOpen(false);
        });
      }
      document
        .querySelectorAll<HTMLAnchorElement>('[data-language-link]')
        .forEach((link) => {
          link.addEventListener('click', () => {
            let anchor = window.location.hash.slice(1);
            try {
              anchor = decodeURIComponent(anchor);
            } catch {
              /* Preserve a malformed fragment without interrupting navigation. */
            }
            const anchors = JSON.parse(
              link.dataset.alternateAnchors ?? '{}',
            ) as Record<string, string>;
            link.hash = anchors[anchor] ?? window.location.hash;
          });
        });
    </script>
  </body>
</html>
