# Set to password to enable email/password sign-in (accounts are created by the owner).
AUTH_PROVIDER=
# Optional extra safety net: comma-separated emails allowed to sign in.
AUTH_ALLOWED_EMAILS=
# Origin only, no path. HTTPS except localhost/127.0.0.1 local development.
AUTH_SITE_URL=http://localhost:4321
SUPABASE_URL=
# Use sb_publishable_... from Connect. Never a secret/service-role key.
SUPABASE_PUBLISHABLE_KEY=
# Server-only key for saving attempts: Supabase Project Settings > API Keys (sb_secret_...). Never commit or expose it.
SUPABASE_SECRET_KEY=
