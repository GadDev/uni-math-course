# Google is an initial implementation choice; enable only after provider setup.
AUTH_PROVIDER=
# Origin only, no path. HTTPS except localhost/127.0.0.1 local development.
AUTH_SITE_URL=http://localhost:4321
SUPABASE_URL=
# Use sb_publishable_... from Connect. Never a secret/service-role key.
SUPABASE_PUBLISHABLE_KEY=
